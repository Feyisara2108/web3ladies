# Web3Ladies — environment variables
# Copy this file to .env.local and fill in values from your Supabase project
# (Supabase Dashboard → Project Settings → API).

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY — never expose to the browser. Used only in authorized server code
# (Server Actions / Route Handlers) for privileged operations. Keep out of git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
